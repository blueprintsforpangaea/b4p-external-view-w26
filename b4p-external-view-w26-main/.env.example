# Google Sheets
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_SHEET_ID=your_spreadsheet_id

# Worksheet tab for internal clinic requests (POST /api/requests)
REQUESTS_WORKSHEET_TITLE=Requests

# Worksheet tab for external org requests (POST /requests)
# Must have columns: Request ID | Org Name | Org Email | Item Name | Category |
#                    Quantity Requested | Status | Timestamp | Review Flag
ORG_REQUESTS_WORKSHEET_TITLE=Requests

# Gmail SMTP
# 1. Enable 2-Step Verification on your Google account
# 2. Go to myaccount.google.com/apppasswords
# 3. Generate a password for "Mail" — it will be 16 chars (spaces optional)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Who receives HQ alerts and org status update emails
HQ_EMAIL=hq@yourdomain.org

# Uncomment to skip Google Sheets and use sample_inventory.json instead
# USE_SAMPLE_DATA=1
